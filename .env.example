# Copy to .env and fill in.  .env is gitignored — never commit real keys.
#
# Gmail and Google Sheets do NOT use an API key. They use OAuth:
#   1. Create a Google Cloud project, enable the Gmail API and Google Sheets API
#   2. Create an OAuth client ID (Desktop app), download it as credentials.json
#   3. Run: .venv/bin/python scripts/google_auth.py
# See the header of scripts/google_auth.py for the full walkthrough.

# --- Firecrawl (web sourcing — finds companies + live tech stack) ---
# Get a key at firecrawl.dev. Free tier is a one-time credit grant; each scrape is 1 credit.
FIRECRAWL_API_KEY=

# --- Apollo (lead sourcing) ---
# Paid plan with API access required. Search is free; unlocking emails costs credits.
APOLLO_API_KEY=

# --- Google Sheets (CRM — replaces GoHighLevel) ---
# The long id in your sheet's URL, between /d/ and /edit
GOOGLE_SHEET_ID=

# --- Gmail sending ---
# The From address is NOT set here — it comes from the Google account you authorised
# with scripts/google_auth.py. Nothing below changes who the mail is from.
SENDER_NAME=Maha
SENDER_COMPANY=Mail It Better
# Required by CAN-SPAM: a real physical STREET address (street, town, postcode,
# country), shown in every email footer. An email address does not satisfy this.
# send_approved.py refuses to send while this is blank. LinkedIn drafting still works.
SENDER_ADDRESS=

# Stay well under Gmail's ceiling to protect the warmed domain.
GMAIL_DAILY_CAP=40
# Random pause between sends, in seconds — avoids a burst pattern.
SEND_GAP_MIN_SECONDS=90
SEND_GAP_MAX_SECONDS=420
# How far back to look for a reply before sending a follow-up.
REPLY_LOOKBACK_DAYS=45

# --- Email verification (integration NOT built yet) ---
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=

# --- Qualification filters ---
ECOM_MIN_EMPLOYEES=10
ECOM_MAX_EMPLOYEES=200
# Revenue band from CLAUDE.md Section 3. Employee count alone lets through brands far
# outside it, so this is the check that actually holds the line. Apollo supplies the
# figure; a lead with no figure is not judged rather than guessed at.
ECOM_MIN_REVENUE=1000000
ECOM_MAX_REVENUE=20000000
AGENCY_MIN_EMPLOYEES=5
AGENCY_MAX_EMPLOYEES=50
DIVERSIFY_CAP_PCT=25
DIVERSIFY_MIN_BATCH=20
ALLOWED_COUNTRIES=
